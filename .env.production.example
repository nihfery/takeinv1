APP_NAME=YouYaku
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.takein.id
APP_TIMEZONE=Asia/Jakarta
DEMO_LOGIN_HINTS=false
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_JSON_INCLUDE_STACKTRACES=false

# Enable only behind the private trusted reverse-proxy boundary.
OBSERVABILITY_TRUST_INBOUND_IDS=false
# Optional and fail-open. Booking/payment/audit do not require a collector.
OBSERVABILITY_TELEMETRY_ENABLED=false
OTEL_SDK_DISABLED=false
OTEL_SERVICE_NAME=youyaku-laravel
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/json
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_TIMEOUT=50
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=production,service.namespace=youyaku

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=youyaku
DB_USERNAME=youyaku
DB_PASSWORD=replace_with_the_same_long_random_mysql_password

# Required by the root Compose database service. Inject real values through
# the orchestrator; DB_PASSWORD and MYSQL_PASSWORD must represent the same app
# user credential.
MYSQL_PASSWORD=replace_with_the_same_long_random_mysql_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_long_random_mysql_root_password

SESSION_DRIVER=redis
SESSION_CONNECTION=sessions
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
SESSION_HTTP_ONLY=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=

# Keep the cookie host-only unless a separate threat-model review approves a
# shared .takein.id cookie.
SANCTUM_STATEFUL_DOMAINS=takein.id,www.takein.id,api.takein.id
PROVIDER_FRONTEND_URL=https://partners.takein.id
CUSTOMER_FRONTEND_URL=https://takein.id

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=public
# Local private/public disks are the safe initial deployment default. Switch the
# storage target variables to media_*_s3 only after the bucket is provisioned and
# the explicit copy/verify + cutover runbook has completed.
MEDIA_PUBLIC_DISK=media_public
MEDIA_PRIVATE_DISK=media_private
MEDIA_LEGACY_PUBLIC_DISK=public
MEDIA_LEGACY_ARCHIVE_DISK=media_private
MEDIA_LEGACY_ARCHIVE_PREFIX=legacy-retirement
MEDIA_LEGACY_RETIREMENT_ENABLED=false
MEDIA_LEGACY_RETIREMENT_MIN_AGE_DAYS=30
CHAT_ATTACHMENTS_DISK=media_private
MEDIA_PRIVATE_URL_LIFETIME=10
PROVIDER_DOCUMENTS_DISK=provider_documents
PROVIDER_DOCUMENT_URL_LIFETIME=5
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_LIMITER=rate_limits

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=replace_with_a_long_random_password
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_QUEUE_DB=3
REDIS_RATE_LIMIT_DB=4
REDIS_HORIZON_DB=5
REDIS_REVERB_DB=6
REDIS_CACHE_CONNECTION=cache
REDIS_CACHE_LOCK_CONNECTION=default
REDIS_RATE_LIMIT_CONNECTION=rate_limits
REDIS_QUEUE_CONNECTION=queue
REDIS_QUEUE=default
# Must remain greater than HORIZON_WORKER_TIMEOUT.
REDIS_QUEUE_RETRY_AFTER=120
REDIS_QUEUE_BLOCK_FOR=5
REDIS_QUEUE_AFTER_COMMIT=true

HORIZON_REDIS_CONNECTION=horizon_meta
HORIZON_PREFIX=youyaku_horizon:
HORIZON_WORKER_TIMEOUT=90
HORIZON_WORKER_TRIES=3
HORIZON_MEMORY_LIMIT=64
HORIZON_CRITICAL_MAX_PROCESSES=3
HORIZON_BUSINESS_MAX_PROCESSES=6
HORIZON_BACKGROUND_MAX_PROCESSES=2

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@takein.id
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
MEDIA_PUBLIC_PREFIX=public
MEDIA_PRIVATE_PREFIX=private

MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=true
ALLOW_CUSTOMER_MANUAL_PAYMENT_CONFIRMATION=false

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=ws.takein.id
REVERB_PORT=443
REVERB_SCHEME=https
# Explicit browser hostnames only (no scheme, port, path, or wildcard).
REVERB_ALLOWED_ORIGINS=takein.id,www.takein.id,partners.takein.id,provider.takein.id,admin.takein.id
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_SCALING_ENABLED=true
REVERB_BROADCAST_HOST=reverb
REVERB_BROADCAST_PORT=8080
REVERB_BROADCAST_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
