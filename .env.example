APP_NAME=JasaKu
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Jakarta
DEMO_LOGIN_HINTS=false
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=

# Bind php artisan serve to the local network.
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Comma-separated reverse-proxy IPs/CIDRs. Never use * on a public origin.
TRUSTED_PROXIES=127.0.0.1,::1

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_JSON_INCLUDE_STACKTRACES=false

# Accept upstream IDs only from TRUSTED_PROXIES. Keep false when PHP is
# reachable directly; generated IDs are always returned either way.
OBSERVABILITY_TRUST_INBOUND_IDS=false
OBSERVABILITY_TELEMETRY_ENABLED=false
OTEL_SDK_DISABLED=false
OTEL_SERVICE_NAME=youyaku-laravel
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/json
OTEL_EXPORTER_OTLP_HEADERS=
# Milliseconds; one attempt and no application-side retry.
OTEL_EXPORTER_OTLP_TIMEOUT=50
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local,service.namespace=youyaku

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jasaku1
DB_USERNAME=root
DB_PASSWORD=

# Root Compose provisions its own MySQL user/database. Use different random
# values locally and never commit the populated .env file.
MYSQL_PASSWORD=replace_with_a_local_mysql_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_local_mysql_root_password

SESSION_DRIVER=redis
SESSION_CONNECTION=sessions
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=true
SESSION_HTTP_ONLY=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,localhost:5174,127.0.0.1,127.0.0.1:8000,127.0.0.1:5173,127.0.0.1:5174

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
MEDIA_PUBLIC_DISK=media_public
MEDIA_PRIVATE_DISK=media_private
MEDIA_LEGACY_PUBLIC_DISK=public
MEDIA_LEGACY_ARCHIVE_DISK=media_private
MEDIA_LEGACY_ARCHIVE_PREFIX=legacy-retirement
MEDIA_LEGACY_RETIREMENT_ENABLED=false
MEDIA_LEGACY_RETIREMENT_MIN_AGE_DAYS=30
CHAT_ATTACHMENTS_DISK=media_private
MEDIA_PRIVATE_URL_LIFETIME=10
PROVIDER_DOCUMENTS_DISK=provider_documents
PROVIDER_DOCUMENT_URL_LIFETIME=5
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_LIMITER=rate_limits

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=replace_with_a_local_redis_password
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_QUEUE_DB=3
REDIS_RATE_LIMIT_DB=4
REDIS_HORIZON_DB=5
REDIS_REVERB_DB=6
REDIS_CACHE_CONNECTION=cache
REDIS_CACHE_LOCK_CONNECTION=default
REDIS_RATE_LIMIT_CONNECTION=rate_limits
REDIS_QUEUE_CONNECTION=queue
REDIS_QUEUE=default
# Must remain greater than HORIZON_WORKER_TIMEOUT.
REDIS_QUEUE_RETRY_AFTER=120
REDIS_QUEUE_BLOCK_FOR=5
REDIS_QUEUE_AFTER_COMMIT=true

HORIZON_REDIS_CONNECTION=horizon_meta
HORIZON_PREFIX=youyaku_horizon:
HORIZON_WORKER_TIMEOUT=90
HORIZON_WORKER_TRIES=3
HORIZON_MEMORY_LIMIT=64
HORIZON_CRITICAL_MAX_PROCESSES=1
HORIZON_BUSINESS_MAX_PROCESSES=1
HORIZON_BACKGROUND_MAX_PROCESSES=1

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
MEDIA_PUBLIC_PREFIX=public
MEDIA_PRIVATE_PREFIX=private

# For local network testing, replace 127.0.0.1 with this computer's LAN IP.
PROVIDER_FRONTEND_URL=http://127.0.0.1:5173
CUSTOMER_FRONTEND_URL=http://127.0.0.1:5174

MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
ALLOW_CUSTOMER_MANUAL_PAYMENT_CONFIRMATION=true
# For local testing, set this in Midtrans Dashboard to your ngrok URL:
# https://your-ngrok-domain.ngrok-free.app/api/midtrans/notification

REVERB_APP_ID=123456
REVERB_APP_KEY=local-key
REVERB_APP_SECRET=local-secret
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
# Reverb matches hostnames parsed from browser Origin headers. Do not include
# schemes, ports, paths, or wildcard entries.
REVERB_ALLOWED_ORIGINS=localhost,127.0.0.1
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_SCALING_ENABLED=true
# Native local PHP publishes to the loopback Reverb process. Compose overrides
# this value with its internal `reverb` service name.
REVERB_BROADCAST_HOST=127.0.0.1
REVERB_BROADCAST_PORT=8080
REVERB_BROADCAST_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
