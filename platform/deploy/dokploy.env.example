# Copy these values into Dokploy → Docker Compose → Environment.
# Do not commit your real secrets to GitHub.

# Laravel
APP_KEY=base64:GENERATE_WITH_php_artisan_key_generate_show
# Use the public HTTPS URL without a trailing slash.
APP_URL=https://api.example.com
APP_TIMEZONE=Asia/Jakarta
SESSION_LIFETIME=120
# Keep true when the public applications use HTTPS.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
# Leave blank for host-only cookies, or use .example.com for shared subdomains.
SESSION_DOMAIN=
# Hostnames only: do not include https://, paths, or trailing slashes.
SANCTUM_STATEFUL_DOMAINS=api.example.com,app.example.com,business.example.com

# Public frontend addresses without trailing slashes.
CUSTOMER_FRONTEND_URL=https://app.example.com
PROVIDER_FRONTEND_URL=https://business.example.com

# Dokploy/Traefik routes directly to internal container ports. The production
# Compose file does not publish backend, Reverb, provider, or customer ports on
# the VPS host. Host-port variables belong only to the local Compose override.
# Optional local/profile gateway (`docker compose --profile gateway ...`). The
# production edge can route ws.example.com to this private Nginx entrypoint.
GATEWAY_BIND_ADDRESS=127.0.0.1
GATEWAY_HOST_PORT=8088

# Wildcard proxy trust is acceptable here only because the backend origin is
# loopback-bound and reachable externally solely through Dokploy/Traefik.
TRUSTED_PROXIES=*
LOG_CHANNEL=stderr
LOG_LEVEL=warning
LOG_JSON_INCLUDE_STACKTRACES=false
OBSERVABILITY_TRUST_INBOUND_IDS=false
OBSERVABILITY_TELEMETRY_ENABLED=false
OTEL_SDK_DISABLED=false
OTEL_SERVICE_NAME=youyaku-laravel
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/json
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_TIMEOUT=50
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=production,service.namespace=youyaku

# MySQL. These create credentials only on the first initialization of the
# persistent youyaku_mysql volume. Changing them later does not reset data.
MYSQL_PASSWORD=replace_with_a_long_random_password
MYSQL_ROOT_PASSWORD=replace_with_another_long_random_password

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=youyaku
DB_USERNAME=youyaku
DB_PASSWORD=${MYSQL_PASSWORD}

# Redis is private to the Compose data network and still requires a password.
# Its AOF data lives in the persistent youyaku_redis volume.
REDIS_PASSWORD=replace_with_a_third_long_random_password
REDIS_QUEUE_RETRY_AFTER=120
REDIS_QUEUE_BLOCK_FOR=5
HORIZON_WORKER_TIMEOUT=90
HORIZON_WORKER_TRIES=3
HORIZON_MEMORY_LIMIT=64
HORIZON_CRITICAL_MAX_PROCESSES=3
HORIZON_BUSINESS_MAX_PROCESSES=6
HORIZON_BACKGROUND_MAX_PROCESSES=2

# Reverb credentials are application secrets. REVERB_HOST is the public
# websocket hostname; the Laravel-to-Reverb hop stays inside Compose.
REVERB_APP_ID=replace_with_a_reverb_app_id
REVERB_APP_KEY=replace_with_a_long_reverb_app_key
REVERB_APP_SECRET=replace_with_a_long_reverb_app_secret
REVERB_HOST=ws.example.com
REVERB_PORT=443
REVERB_SCHEME=https
# Browser page hostnames only. Reverb rejects wildcard/scheme/path entries in
# production; include every customer/provider/admin origin that uses realtime.
REVERB_ALLOWED_ORIGINS=app.example.com,business.example.com,api.example.com

# Payment. Keep false for Midtrans sandbox; set true only with production keys.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
ALLOW_CUSTOMER_MANUAL_PAYMENT_CONFIRMATION=false

# Provider identity documents stay private and signed URLs remain short-lived.
MEDIA_PUBLIC_DISK=media_public
MEDIA_PRIVATE_DISK=media_private
MEDIA_LEGACY_PUBLIC_DISK=public
MEDIA_LEGACY_ARCHIVE_DISK=media_private
MEDIA_LEGACY_ARCHIVE_PREFIX=legacy-retirement
MEDIA_LEGACY_RETIREMENT_ENABLED=false
MEDIA_LEGACY_RETIREMENT_MIN_AGE_DAYS=30
CHAT_ATTACHMENTS_DISK=media_private
MEDIA_PRIVATE_URL_LIFETIME=10
PROVIDER_DOCUMENTS_DISK=provider_documents
PROVIDER_DOCUMENT_URL_LIFETIME=5

# Optional S3/R2-compatible media target. Keep the media disk names above on
# their local defaults until external object storage is actually provisioned.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
MEDIA_PUBLIC_PREFIX=public
MEDIA_PRIVATE_PREFIX=private

# Creates a SQL snapshot in the persistent storage volume before pending
# migrations are applied. Keep enabled for production deployments.
DEPLOY_BACKUP_BEFORE_MIGRATE=true
