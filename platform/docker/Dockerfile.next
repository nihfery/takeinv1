FROM node:22-alpine

ARG APP_PATH

ARG NEXT_PUBLIC_BACKEND_URL
ARG NEXT_PUBLIC_API_BASE_URL
ARG NEXT_PUBLIC_PROVIDER_FRONTEND_URL
ARG NEXT_PUBLIC_CUSTOMER_APP_URL
ARG NEXT_PUBLIC_PROVIDER_LOGIN_PATH
ARG NEXT_PUBLIC_PROVIDER_DASHBOARD_PATH
ARG NEXT_PUBLIC_ALLOW_MANUAL_PAYMENT_CONFIRMATION=false
ARG BACKEND_PROXY_URL

ARG VITE_BACKEND_URL
ARG VITE_API_BASE_URL
ARG VITE_PROVIDER_LOGIN_PATH
ARG VITE_PROVIDER_DASHBOARD_PATH

ENV NEXT_PUBLIC_BACKEND_URL=$NEXT_PUBLIC_BACKEND_URL
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
ENV NEXT_PUBLIC_PROVIDER_FRONTEND_URL=$NEXT_PUBLIC_PROVIDER_FRONTEND_URL
ENV NEXT_PUBLIC_CUSTOMER_APP_URL=$NEXT_PUBLIC_CUSTOMER_APP_URL
ENV NEXT_PUBLIC_PROVIDER_LOGIN_PATH=$NEXT_PUBLIC_PROVIDER_LOGIN_PATH
ENV NEXT_PUBLIC_PROVIDER_DASHBOARD_PATH=$NEXT_PUBLIC_PROVIDER_DASHBOARD_PATH
ENV NEXT_PUBLIC_ALLOW_MANUAL_PAYMENT_CONFIRMATION=$NEXT_PUBLIC_ALLOW_MANUAL_PAYMENT_CONFIRMATION
ENV BACKEND_PROXY_URL=$BACKEND_PROXY_URL

ENV VITE_BACKEND_URL=$VITE_BACKEND_URL
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_PROVIDER_LOGIN_PATH=$VITE_PROVIDER_LOGIN_PATH
ENV VITE_PROVIDER_DASHBOARD_PATH=$VITE_PROVIDER_DASHBOARD_PATH

WORKDIR /app

COPY ${APP_PATH}/package*.json ./

RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi

COPY ${APP_PATH}/ ./

RUN npm run build

EXPOSE 3000
EXPOSE 5174

CMD ["npm", "run", "start"]
